<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>br.com.tw</groupId>
    <artifactId>tw-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <purpur.version>26.3.build.2652-stable</purpur.version>
    </properties>

    <modules>
        <module>tw-core</module>
        <module>tw-economia</module>
        <module>tw-ranks</module>
        <module>tw-minas</module>
        <module>tw-terrenos</module>
        <module>tw-maquinas</module>
        <module>tw-spawners</module>
        <module>tw-farms</module>
        <module>tw-caixas</module>
    </modules>

    <repositories>
        <!-- Repositório PurpurMC -->
        <repository>
            <id>purpurmc</id>
            <url>https://repo.purpurmc.org/snapshots/</url>
        </repository>
        <!-- Repositório PaperMC (Dependências upstream) -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- PlaceholderAPI -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
        <!-- JitPack (Vault) -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Purpur API Nativa -->
            <dependency>
                <groupId>org.purpurmc.purpur</groupId>
                <artifactId>purpur-api</artifactId>
                <version>${purpur.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- Vault -->
            <dependency>
                <groupId>com.github.MilkBowl</groupId>
                <artifactId>VaultAPI</artifactId>
                <version>1.7</version>
                <scope>provided</scope>
            </dependency>
            <!-- HikariCP 5+ (Obrigatório para Java 25) -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>5.1.0</version>
                <scope>compile</scope>
            </dependency>
            <!-- PostgreSQL JDBC -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.4</version>
                <scope>compile</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>